{
  "manifest_version": 3,
  "name": "Job CRM Clipper",
  "version": "1.0.0",
  "description": "Save the job posting on the current page to your local Job CRM and see its fit score.",
  "action": { "default_popup": "popup.html", "default_title": "Save to Job CRM" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save this posting to Job CRM" }
  }
}
