# ---------------------------------------------------------------------------
# Autonoma — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase
# project dashboard (Project Settings → API).
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# The "anon" / publishable key. Safe to use server-side here.
# (Project Settings → API → Project API keys → anon public)
SUPABASE_ANON_KEY=
